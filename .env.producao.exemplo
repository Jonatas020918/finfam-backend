# Configuração de produção — domínio e e-mail na Hostinger.
#
# Copie para .env no servidor e troque SEUDOMINIO pelo domínio real. Nada aqui
# tem segredo de verdade: as senhas e chaves são preenchidas no servidor.
#
# Depois de preencher, valide antes de subir:
#
#     python manage.py check --deploy
#     python manage.py testar_email voce@SEUDOMINIO.com.br
#
# O primeiro trava se algo estiver incoerente. O segundo prova que o e-mail
# realmente sai da máquina — que é a falha mais silenciosa da lista.

# --- Básico ----------------------------------------------------------------

DEBUG=False

# Gere uma chave nova, com pelo menos 50 caracteres:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=

# Domínios que respondem por esta aplicação. Sem curinga: com '*', um Host
# forjado entra no link de redefinição de senha que enviamos ao cliente.
ALLOWED_HOSTS=api.SEUDOMINIO.com.br,SEUDOMINIO.com.br

# De onde o navegador chama a API.
CORS_ALLOWED_ORIGINS=https://app.SEUDOMINIO.com.br,https://SEUDOMINIO.com.br

# Origens confiáveis para POST de sessão. Sem isto, o login do admin em HTTPS
# falha com "CSRF verification failed" e nada explica o motivo.
CSRF_TRUSTED_ORIGINS=https://api.SEUDOMINIO.com.br,https://app.SEUDOMINIO.com.br

# Onde o cliente clica: o link do e-mail leva a uma tela, não à API.
FRONTEND_URL=https://app.SEUDOMINIO.com.br

# --- Banco e fila ----------------------------------------------------------

DATABASE_URL=postgres://finfam:TROQUE_ESTA_SENHA@db:5432/finfam
CELERY_BROKER_URL=redis://redis:6379/0

# --- E-mail (Hostinger) ----------------------------------------------------
#
# A Hostinger vende duas caixas diferentes, e o host muda conforme a sua:
#
#   Hostinger Email ....... smtp.hostinger.com
#   Titan Email ........... smtp.titan.email
#
# Confirme em hPanel → E-mails → Configurações de e-mail. As duas publicam a
# porta 465 com SSL e a 587 com STARTTLS; 465 é a recomendada.
#
# A criptografia acompanha a porta automaticamente — só declare EMAIL_USE_SSL
# ou EMAIL_USE_TLS se precisar contrariar esse padrão. Ligar as duas trava o
# check --deploy, porque o Django recusa a conexão com ambas.

EMAIL_HOST=smtp.hostinger.com
EMAIL_PORT=465

# O endereço completo do mailbox, não o usuário do painel.
EMAIL_HOST_USER=nao-responda@SEUDOMINIO.com.br

# A senha do mailbox, criada em hPanel → E-mails → Contas de e-mail.
EMAIL_HOST_PASSWORD=

# O que o cliente vê como remetente. Precisa ser um endereço do mesmo domínio,
# ou os provedores tratam a mensagem como falsificada.
DEFAULT_FROM_EMAIL=Pulso <nao-responda@SEUDOMINIO.com.br>

# --- Pagamento -------------------------------------------------------------
#
# Enquanto o gateway for o mock, nenhuma cobrança acontece de verdade e o
# check --deploy avisa. Para cobrar, troque pela classe real e preencha as
# chaves — mais os stripe_price_id e stripe_coupon_id de cada plano no admin.

ASSINATURA_GATEWAY=apps.billing.gateways_stripe.GatewayStripe
STRIPE_SECRET_KEY=
STRIPE_PUBLIC_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Integrações -----------------------------------------------------------

ANTHROPIC_API_KEY=

# --- DNS: o que precisa existir na zona do domínio -------------------------
#
# Sem estes três registros, o e-mail sai do servidor e cai no spam do cliente
# — o que, do lado dele, é idêntico a não ter chegado.
#
#   MX      aponta para os servidores que a Hostinger indica no hPanel
#   SPF     TXT "v=spf1 include:_spf.mail.hostinger.com ~all"
#   DKIM    TXT gerado no hPanel, em E-mails → Configurações de DNS
#   DMARC   TXT em _dmarc: "v=DMARC1; p=none; rua=mailto:voce@SEUDOMINIO.com.br"
#
# Comece o DMARC com p=none: ele só relata, sem descartar nada. Depois de
# algumas semanas de relatório limpo, endureça para p=quarantine.
#
# Confira os valores exatos de SPF e DKIM no hPanel: a Hostinger ajusta o
# include conforme a caixa contratada.
