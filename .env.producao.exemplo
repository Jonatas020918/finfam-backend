# Configuração de produção do Batimento.
#
# Copie para `.env` no servidor, na pasta do finfam-backend, e preencha o que
# está em branco. Este arquivo é o único lugar com segredos — ele não vai para
# o Git (o .gitignore já cuida disso).
#
#     cp .env.producao.exemplo .env
#     nano .env
#
# Depois de preencher, valide ANTES de subir:
#
#     docker compose -f docker-compose.prod.yml run --rm api python manage.py check --deploy
#     docker compose -f docker-compose.prod.yml run --rm api python manage.py testar_email voce@batimento.com.br
#
# O primeiro trava se algo estiver incoerente. O segundo prova que o e-mail
# realmente sai da máquina — a falha mais silenciosa de todas.
#
# ===========================================================================
# LEGENDA DE ONDE ENCONTRAR CADA VALOR
#
#   [você]      você inventa ou decide
#   [gerar]     tem um comando que gera
#   [hPanel]    painel da Hostinger
#   [Stripe]    painel do Stripe
#   [Anthropic] console da Anthropic
# ===========================================================================


# --- 1. Básico -------------------------------------------------------------

# [você] Nunca True em produção: expõe rastreamento de erro e desliga a
# segurança de cookies.
DEBUG=False

# [gerar] Assinatura dos tokens e dos cookies. Se vazar, qualquer um forja
# sessão. Gere uma nova, com pelo menos 50 caracteres:
#
#     docker compose -f docker-compose.prod.yml run --rm api \
#       python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=

# [você] Domínios que respondem por esta aplicação. Sem curinga: com '*', um
# Host forjado entra no link de redefinição de senha que enviamos ao cliente.
ALLOWED_HOSTS=batimento.com.br,www.batimento.com.br

# [você] De onde o navegador pode chamar a API.
CORS_ALLOWED_ORIGINS=https://batimento.com.br,https://www.batimento.com.br

# [você] Origens confiáveis para POST de sessão. Sem isto, o login do admin em
# HTTPS falha com "CSRF verification failed" e nada explica o motivo.
CSRF_TRUSTED_ORIGINS=https://batimento.com.br,https://www.batimento.com.br

# [você] Onde o cliente clica: o link do e-mail leva a uma tela, não à API.
FRONTEND_URL=https://batimento.com.br


# --- 2. HTTPS e domínio (usados pelo Caddy) --------------------------------

# [você] O domínio que o Caddy vai proteger. O DNS precisa apontar para o IP
# do servidor ANTES de subir: a Let's Encrypt confirma a posse por HTTP.
DOMINIO=batimento.com.br

# [você] E-mail para os avisos da Let's Encrypt (renovação com problema).
# Pode ser o seu pessoal — não aparece para o cliente.
EMAIL_ACME=


# --- 3. Banco de dados -----------------------------------------------------

# [você] Senha do Postgres. Ele não fica exposto na internet (o compose de
# produção não publica a porta), mas gere algo forte assim mesmo:
#
#     openssl rand -hex 24
#
# Hexadecimal, e não base64, de propósito: esta senha entra montada dentro da
# DATABASE_URL (postgres://usuario:SENHA@db:5432/banco), e os caracteres `/`,
# `+` e `=` que o base64 produz quebram a leitura dessa URL. O `/` é o pior —
# ele encerra a seção de autenticação e o Django tenta conectar num host que
# não existe, com um erro que não aponta para a senha.
POSTGRES_USER=batimento
POSTGRES_PASSWORD=
POSTGRES_DB=batimento


# --- 4. E-mail (Hostinger) -------------------------------------------------
#
# [hPanel] A Hostinger vende duas caixas diferentes, e o host muda conforme a
# sua. Confirme em: hPanel → E-mails → Configurações de e-mail.
#
#     Hostinger Email ....... smtp.hostinger.com
#     Titan Email ........... smtp.titan.email
#
# As duas publicam a porta 465 (SSL) e a 587 (STARTTLS). Use a 465.
# A criptografia acompanha a porta automaticamente — só declare EMAIL_USE_SSL
# ou EMAIL_USE_TLS se precisar contrariar esse padrão.

EMAIL_HOST=smtp.hostinger.com
EMAIL_PORT=465

# [hPanel] O endereço COMPLETO do mailbox, não o usuário do painel.
# Crie em: hPanel → E-mails → Contas de e-mail.
EMAIL_HOST_USER=nao-responda@batimento.com.br

# [hPanel] A senha do mailbox, definida na criação da conta de e-mail.
# Não é a senha da sua conta Hostinger.
EMAIL_HOST_PASSWORD=

# [você] O que o cliente vê como remetente. Precisa ser do mesmo domínio, ou
# os provedores tratam a mensagem como falsificada.
DEFAULT_FROM_EMAIL=Batimento <nao-responda@batimento.com.br>


# --- 5. Pagamento (Stripe) -------------------------------------------------
#
# Enquanto o gateway for o mock, NENHUMA cobrança acontece — a plataforma
# funciona, o cliente "assina", e nenhum centavo entra. O check --deploy avisa.
#
# Para o primeiro deploy, dá para deixar o mock: ninguém consegue pagar, então
# ninguém é cobrado errado. Troque quando for começar a vender de verdade.

# [você] Deixe o mock agora; troque para GatewayStripe quando for cobrar.
ASSINATURA_GATEWAY=apps.billing.gateways_stripe.GatewayStripeMock
# ASSINATURA_GATEWAY=apps.billing.gateways_stripe.GatewayStripe

# [Stripe] Desenvolvedores → Chaves de API → "Chave secreta".
# Começa com sk_live_ (produção) ou sk_test_ (teste).
STRIPE_SECRET_KEY=

# [Stripe] Mesma tela, "Chave publicável". Começa com pk_.
STRIPE_PUBLIC_KEY=

# [Stripe] Desenvolvedores → Webhooks → adicione o endpoint
# https://batimento.com.br/api/assinatura/webhook/ e copie o
# "Signing secret". Começa com whsec_.
#
# Sem este segredo a rota do webhook recusa tudo — o que é proposital: sem
# verificação de assinatura, aquele endereço seria um botão público de liberar
# acesso pago.
STRIPE_WEBHOOK_SECRET=
#
# [Stripe] Faltam ainda dois valores POR PLANO, que não moram aqui e sim no
# admin (https://batimento.com.br/admin/ → Billing → Plans):
#
#     stripe_price_id   Produtos → crie o produto → Price recorrente mensal
#                       com o valor CHEIO (49,90 / 99,00 / 599,90). Copia-se
#                       o id que começa com price_.
#
#     stripe_coupon_id  Produtos → Cupons → desconto com "duração: repetido"
#                       por N meses, cobrindo a diferença até o promocional.
#                       Copia-se o id do cupom.


# --- 6. Conteúdo educacional (opcional) ------------------------------------

# [Anthropic] console.anthropic.com → API Keys.
# Usada uma vez por mês para redigir o rascunho do relatório educacional, que
# passa por revisão humana antes de publicar. Deixe em branco se ainda não vai
# usar: a plataforma funciona sem, apenas sem gerar o texto do mês.
ANTHROPIC_API_KEY=


# --- 7. Ajustes com padrão razoável (mexa só se precisar) ------------------

# Dias de teste grátis concedidos no cadastro.
# ASSINATURA_TRIAL_DIAS=14

# Dias de acesso mantidos depois de uma cobrança falhar. Cartão vencido é o
# motivo mais comum, e cortar no mesmo dia perde cliente que só precisava
# atualizar o número.
# ASSINATURA_CARENCIA_DIAS=5

# Processos do gunicorn. Regra prática: 2 × núcleos + 1. No KVM 1 da
# Hostinger (1 núcleo), 3 está bom.
# GUNICORN_WORKERS=3

# Validade do link de redefinição, em segundos. 24h por padrão.
# PASSWORD_RESET_TIMEOUT=86400

# Módulo de consultoria (Fase 2). Enquanto falso, a interface anuncia como
# "em breve" em vez de oferecer.
# FEATURE_CONSULTORIA=False


# ===========================================================================
# 8. DNS — o que precisa existir na zona do domínio [hPanel → DNS]
#
#   A       @      IP_DO_SEU_VPS
#   A       www    IP_DO_SEU_VPS
#
# E, para o e-mail não cair no spam — que do lado do cliente é idêntico a não
# ter chegado:
#
#   MX      @      servidores que a Hostinger indicar
#   TXT     @      "v=spf1 include:_spf.mail.hostinger.com ~all"
#   TXT     ...    DKIM gerado em hPanel → E-mails → Configurações de DNS
#   TXT     _dmarc "v=DMARC1; p=none; rua=mailto:voce@batimento.com.br"
#
# Comece o DMARC com p=none: ele só relata, sem descartar nada. Depois de
# algumas semanas de relatório limpo, endureça para p=quarantine.
# ===========================================================================
