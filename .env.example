# Copie para .env e ajuste. Nunca versione o .env real.

DEBUG=True
SECRET_KEY=troque-esta-chave-em-producao
ALLOWED_HOSTS=localhost,127.0.0.1,api
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Postgres. O docker-compose já injeta esta variável apontando para o serviço
# "db", então deixe comentada aqui: assim o mesmo .env serve para rodar a suíte
# localmente (cai em SQLite) sem quebrar o ambiente Docker.
# DATABASE_URL=postgres://finfam:finfam@localhost:5432/finfam

# Celery / Redis
CELERY_BROKER_URL=redis://redis:6379/0

# E-mail transacional (redefinição de senha). Sem EMAIL_HOST, as mensagens são
# impressas no console — em desenvolvimento o link aparece no terminal.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Batimento <nao-responda@batimento.com.br>

# Para onde o link do e-mail aponta (o frontend, não a API)
FRONTEND_URL=http://localhost:4200

# Pagamento. O padrão é o mock, que simula o Stripe enquanto a conta não está
# configurada. Para usar o Stripe de verdade, troque a linha abaixo por
# apps.billing.gateways_stripe.GatewayStripe e preencha as chaves.
ASSINATURA_GATEWAY=apps.billing.gateways_stripe.GatewayStripeMock
STRIPE_SECRET_KEY=
STRIPE_PUBLIC_KEY=
STRIPE_WEBHOOK_SECRET=

# "Entrar com o Google" — crie em console.cloud.google.com > APIs e serviços
# > Credenciais > ID do cliente OAuth (tipo "Aplicativo da Web"). Cadastre a
# origem do front (ex.: https://batimento.com.br e http://localhost:4200) em
# "Origens JavaScript autorizadas". O mesmo valor vai aqui e no
# googleClientId do frontend.
GOOGLE_OAUTH_CLIENT_ID=

# Dias de teste no cadastro e de carência após cobrança falhar
ASSINATURA_TRIAL_DIAS=14
ASSINATURA_CARENCIA_DIAS=5

# Fase 2 — modo consultoria. Mantenha falso enquanto o painel do consultor,
# as anotações de sessão e a cobrança do plano não existirem: com a flag falsa
# a interface anuncia "em breve" em vez de oferecer a contratação.
FEATURE_CONSULTORIA=False

# Módulo educacional (IA) — sem a chave, o job mensal falha de propósito
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# API pública do Banco Central (Selic/IPCA)
BCB_API_BASE_URL=https://api.bcb.gov.br/dados/serie/bcdata.sgs
