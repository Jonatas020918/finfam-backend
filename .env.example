# Copie para .env e ajuste. Nunca versione o .env real.

DEBUG=True
SECRET_KEY=troque-esta-chave-em-producao
ALLOWED_HOSTS=localhost,127.0.0.1,api
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Postgres. O docker-compose já injeta esta variável apontando para o serviço
# "db", então deixe comentada aqui: assim o mesmo .env serve para rodar a suíte
# localmente (cai em SQLite) sem quebrar o ambiente Docker.
# DATABASE_URL=postgres://finfam:finfam@localhost:5432/finfam

# Celery / Redis
CELERY_BROKER_URL=redis://redis:6379/0

# Fase 2 — modo consultoria. Mantenha falso enquanto o painel do consultor,
# as anotações de sessão e a cobrança do plano não existirem: com a flag falsa
# a interface anuncia "em breve" em vez de oferecer a contratação.
FEATURE_CONSULTORIA=False

# Módulo educacional (IA) — sem a chave, o job mensal falha de propósito
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# API pública do Banco Central (Selic/IPCA)
BCB_API_BASE_URL=https://api.bcb.gov.br/dados/serie/bcdata.sgs
